# Copy this file to .env and edit the values for your local setup.
# .env is gitignored — never commit secrets.

# Path to your local music library (FLAC files)
MUSIC_PATH=./music

# Postgres credentials (must match what docker-compose sets for the db service)
POSTGRES_USER=ownwave
POSTGRES_PASSWORD=ownwave
POSTGRES_DB=ownwave

# Shared secret between Go and Python analytics (not a public API)
ANALYTICS_API_SECRET=replace-me-generate-analytics-secret-32ch

# Number of parallel audio-analysis worker processes (CPU-bound; ~1 per core)
WORKER_CONCURRENCY=2

# Comma-separated browser origins allowed to call the Go API (CORS)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Public app URL used when generating invite links
PUBLIC_APP_URL=http://localhost:8080

# Database URL for running services outside Docker.
# docker-compose builds its own URL from the values above and ignores this.
DATABASE_URL=postgres://ownwave:ownwave@localhost:5432/ownwave

# Public domain used by Caddy for HTTPS
OWNWAVE_DOMAIN=ownwave.example.com

# Frontend hot reload only: `npm run dev` proxies /api to this Go server.
# In Docker, Go serves the built web UI itself.
GO_API_URL=http://localhost:8080

# Mark the session cookie Secure. Set true whenever the app is served over HTTPS
# (docker-compose.prod.yml always sets it). Leave false for plain-HTTP local dev.
OWNWAVE_COOKIE_SECURE=false

# Host port for the app (Go serves the web UI and /api; change if 8080 is in use)
GO_HOST_PORT=8080

# Host binding for Postgres (local tools only; services use the compose network).
# Change if 5432 is in use on the host.
DB_HOST_PORT=127.0.0.1:5432

# Optional genre analysis (off by default). Models are not baked into the image
# unless you rebuild with DOWNLOAD_GENRE_MODELS=true.
ENABLE_GENRE_ANALYSIS=false
DOWNLOAD_GENRE_MODELS=false
GENRE_MODEL_DIR=/app/models
GENRE_SNIPPET_START=30
GENRE_SNIPPET_DURATION=30
GENRE_MIN_CONFIDENCE=0.3
GENRE_MIN_TRACKS_PER_STATION=5
GENRE_FULL_TRACK_MODE=false
