# Copy this file to .env and edit the values for your local setup.
# .env is gitignored — never commit secrets.

# Path to your local music library (FLAC files)
MUSIC_PATH=./music

# Postgres credentials. POSTGRES_PASSWORD is required: docker compose refuses
# to start without it. Generate one with: openssl rand -hex 24
POSTGRES_USER=ownwave
POSTGRES_PASSWORD=
POSTGRES_DB=ownwave

# Shared secret between Go and Python analytics (not a public API). Required;
# at least 16 characters, and both services refuse the old example values.
# Generate one with: openssl rand -hex 32
ANALYTICS_API_SECRET=

# Number of parallel audio-analysis worker processes (CPU-bound; ~1 per core)
WORKER_CONCURRENCY=4

# Comma-separated browser origins allowed to call the Go API (CORS)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Reverse proxies whose X-Forwarded-For header the Go API believes for the client
# IP (rate limits, access log). Comma-separated CIDRs or IPs. Empty = loopback and
# private networks (fine for the bundled Caddy); "none" = trust no proxy.
TRUSTED_PROXIES=

# Secret for creating the first (admin) account on the setup page. Empty = the go
# service makes a random one at each start and logs it ("SETUP TOKEN") while no
# account exists. Only used until that account exists. Generate: openssl rand -hex 16
OWNWAVE_SETUP_TOKEN=

# Public app URL used when generating invite links
PUBLIC_APP_URL=http://localhost:8080

# Database URL for running services outside Docker (use your POSTGRES_PASSWORD).
# docker-compose builds its own URL from the values above and ignores this.
DATABASE_URL=postgres://ownwave:<POSTGRES_PASSWORD>@localhost:5432/ownwave

# Public domain used by Caddy for HTTPS
OWNWAVE_DOMAIN=ownwave.example.com

# Frontend hot reload only: `npm run dev` proxies /api to this Go server.
# In Docker, Go serves the built web UI itself.
GO_API_URL=http://localhost:8080

# Mark the session cookie Secure and send HSTS. Empty = on when PUBLIC_APP_URL starts
# with https:// (docker-compose.prod.yml always sets true). Set false to force it off.
OWNWAVE_COOKIE_SECURE=

# Host port for the app (Go serves the web UI and /api; change if 8080 is in use)
GO_HOST_PORT=8080

# Host binding for Postgres (local tools only; services use the compose network).
# DB_HOST_PORT is a bare port (change it if 5432 is in use on the host); the
# interface is DB_BIND_ADDR. Docker-published ports bypass ufw, so keep loopback.
DB_BIND_ADDR=127.0.0.1
DB_HOST_PORT=5432

# Image tag for the published go/python images (latest, or a commit SHA to pin/roll back)
OWNWAVE_IMAGE_TAG=latest

# Optional genre analysis (off by default). The published python image includes the
# models; a local build only does with DOWNLOAD_GENRE_MODELS=true.
ENABLE_GENRE_ANALYSIS=false
DOWNLOAD_GENRE_MODELS=false
GENRE_MODEL_DIR=/app/models
# Seconds per analysis window; three windows (at 20%, 50% and 75% of a track).
GENRE_WINDOW_SECONDS=20
# Genres from musicbrainz.org: artist tags (sends artist names) and recording,
# release and release group genres (sends the files' MusicBrainz ids).
MUSICBRAINZ_ENABLED=true
# Release genres and styles from Discogs, found through MusicBrainz's Discogs
# links. Needs a personal access token (discogs.com > Settings > Developers);
# Discogs is skipped while it is empty.
DISCOGS_TOKEN=
DISCOGS_ENABLED=true
# Track tags from Last.fm by exact artist and title (sends them to Last.fm).
# Needs an API key (https://www.last.fm/api/account/create); Last.fm is
# skipped while it is empty.
LASTFM_API_KEY=
LASTFM_ENABLED=true
# Outside genres are fetched again once they are this many days old.
OUTSIDE_GENRES_MAX_AGE_DAYS=180

# Music folder watcher: queue a scan once changes have been quiet this many
# seconds, at most this long after the first change, then wait the cooldown.
WATCH_QUIET_SECONDS=60
WATCH_MAX_WAIT_SECONDS=900
WATCH_COOLDOWN_SECONDS=30

# Transcoded stream cache (Opus/AAC qualities), in MB.
TRANSCODE_CACHE_MB=10240

# Optional SoulLite integration (off unless both are set). SoulLite then follows
# every Spotify playlist added here, downloads the tracks the library lacks, and
# unfollows playlists deleted here (keeping its files). SOULLITE_URL is how the go
# container reaches SoulLite; SOULLITE_API_KEY is a SoulLite API Key with "admin"
# scope (Settings → API Keys in SoulLite; "sl_...", shown once).
SOULLITE_URL=
SOULLITE_API_KEY=
